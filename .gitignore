__pycache__/
*.pyc
timelapse_*/
captures/
capturas_unicas/
test_capturas/
venv/

# "**/" para que valga tambien en codigo/MicroscopeOS/profiles/, que es
# donde los escribe el programa.
# Configuracion de envio a la PC: contiene la clave compartida
**/profiles/envio_pc.json
# Configuracion del NAS: contiene usuario y contraseña
**/profiles/respaldo_nas.json
# Ajustes que crea la interfaz al usarla (colores de luz, optica, marca
# de agua, logo propio, calibracion de imagen)
**/profiles/iluminacion.json
**/profiles/optica.json
**/profiles/marca_agua.json
**/profiles/logo.png
**/profiles/calibracion_imagen.json
**/profiles/flat_cam*.npy
# Fotos y experimentos
codigo/MicroscopeOS/datos/

# LaTeX (docs/articulo): solo se versionan el .tex, el .bib y el PDF
docs/articulo/*.aux
docs/articulo/*.bbl
docs/articulo/*.blg
docs/articulo/*.log
docs/articulo/*.out
docs/articulo/*.spl
